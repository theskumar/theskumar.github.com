    "text": {
      "heading": {
        "$value": "{color.paper.900}",
        "$description": "Ink: headings, links, strong (--heading).",
        "$extensions": {
          "com.pi-pocket": {
            "contrast": {
              "on": "{color.bg.page}",
              "min": 4.5
            }
          }
        }
      },
      "primary": {
        "$value": "{color.paper.800}",
        "$description": "Body text (--text).",
        "$extensions": {
          "com.pi-pocket": {
            "contrast": {
              "on": "{color.bg.page}",
              "min": 4.5
            }
          }
        }
      },
      "muted": {
        "$value": "{color.paper.600}",
        "$description": "Secondary text; the lightest text color (--muted).",
        "$extensions": {
