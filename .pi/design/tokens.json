      "$value": "450ms",
      "$description": "View-transition cross-fade."
    },
    "reveal": {
      "$value": "650ms",
      "$description": "Content rise + fade."
    },
    "draw": {
      "$value": "1100ms",
      "$description": "Edges drawn on via stroke-dashoffset."
    }
