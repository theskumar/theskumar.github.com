{{- /* TIL feed at /til/rss.xml: one item per week, the 5 newest. */ -}}
{{- printf "<?xml version=\"1.0\" encoding=\"UTF-8\"?>" | safeHTML }}
<rss version="2.0" xmlns:content="http://purl.org/rss/1.0/modules/content/">
<channel>
  <title>TIL — Saurabh Kumar</title>
  <description>A collection of useful things I've learned.</description>
  <link>{{ "/til/" | absURL }}</link>
{{- range first 5 (sort (site.GetPage "/til/weekly").RegularPages "Params.week" "desc") }}
  {{- $html := "" }}
  {{- range partial "til/week-notes.html" .Params.week }}{{ $html = printf "%s<li>%s<p><a href=\"%s\">Permalink</a></p></li>" $html .Content .Permalink }}{{ end }}
<item>
  <guid>{{ .Permalink }}</guid>
  <link>{{ .Permalink }}</link>
  <title>Week of {{ .Title }}</title>
  <pubDate>{{ (time.AsTime (printf "%sT00:00:00Z" .Params.week)).Format "Mon, 02 Jan 2006 15:04:05 GMT" }}</pubDate>
  <content:encoded>{{ printf "<ul>%s</ul>" $html | html }}</content:encoded>
</item>
{{- end }}
</channel>
</rss>
