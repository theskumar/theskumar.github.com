{{/*
  Week pages for TIL: /til/weekly/YYYY-MM-DD.html, one per week that has
  notes. They back /til/rss.xml and old Mastodon links (#anchor), and are
  not in the site nav or the sitemap.

  This is the only place that decides a note's week: the Sunday after its
  date, in UTC. The date comes from the filename (content/til/<unix-ts>.md;
  scripts/check-til.py keeps front matter `date` equal to it), so the
  adapter never reads note contents. Each week page gets `params.notes`,
  its notes' IDs, newest first; templates read that instead of recomputing.
*/}}
{{ $weeks := dict }}
{{ range os.ReadDir "content/til" }}
  {{ with findRESubmatch `^(\d+)\.md$` .Name 1 }}
    {{ $id := index (index . 0) 1 }}
    {{ $d := (time.AsTime (int $id)).UTC }}
    {{ $days := mod (sub 7 (int $d.Weekday)) 7 }}
    {{ if eq $days 0 }}{{ $days = 7 }}{{ end }}
    {{ $wk := ($d.AddDate 0 0 $days).Format "2006-01-02" }}
    {{ $weeks = merge $weeks (dict $wk ((index $weeks $wk | default slice) | append $id)) }}
  {{ end }}
{{ end }}

{{ $keys := slice }}
{{ range $k, $_ := $weeks }}{{ $keys = $keys | append $k }}{{ end }}
{{ $keys = sort $keys "value" "desc" }}
{{ range $i, $wk := $keys }}
  {{/* IDs are all 10-digit timestamps, so string order is time order. */}}
  {{ $ids := sort (index $weeks $wk) "value" "desc" }}
  {{ $.AddPage (dict
      "path" $wk
      "url" (printf "/til/weekly/%s.html" $wk)
      "kind" "page"
      "layout" "week"
      "title" ((time.AsTime (printf "%sT12:00:00Z" $wk)).Format "Mon, Jan 2, 2006")
      "dates" (dict "date" (time.AsTime (int (index $ids 0))))
      "sitemap" (dict "disable" true)
      "outputs" (slice "html")
      "params" (dict
        "week" $wk
        "notes" $ids
        "older" (cond (lt (add $i 1) (len $keys)) (index $keys (add $i 1)) "")
        "newer" (cond (gt $i 0) (index $keys (sub $i 1)) ""))
  ) }}
{{ end }}
